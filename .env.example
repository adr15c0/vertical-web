# Copy to .env and fill in locally. NEVER commit real values.
# Deployed environments read these from Azure Key Vault.

# --- WordPress (local DDEV / target) ---
WP_BASE_URL=http://vertical-web.ddev.site
WP_APP_USER=
WP_APP_PASSWORD=

# --- Postgres tooling DB (Azure parity) ---
TOOLING_DB_HOST=
TOOLING_DB_PORT=5432
TOOLING_DB_NAME=vertical_tooling
TOOLING_DB_USER=
TOOLING_DB_PASSWORD=

# --- Azure OpenAI (translation drafts) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Vertical DB (read-only, research spike) ---
VERTICAL_DB_URL=
