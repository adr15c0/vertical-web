# Console BFF — local dev config (copy to .env). Local creds only.
TOOLING_DB_HOST=127.0.0.1
TOOLING_DB_PORT=5433
TOOLING_DB_NAME=vertical_tooling
TOOLING_DB_USER=tooling
TOOLING_DB_PASSWORD=tooling

# WordPress REST (Application Password). Leave blank to disable the pages proxy.
